{% extends 'base.html.twig' %}

{% block title %}Gérer les films - GrandCiné{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/gererFilm.css') }}">
{% endblock %}

{% block body %}
<main class="admin">

    {% include 'partials/header.html.twig' %}

    {% for message in app.flashes('success') %}
        <p class="flash">{{ message }}</p>
    {% endfor %}

    {# ---------- PARTIE 1 : tableau des films ---------- #}
    <section class="bloc">
        <h1 class="titre">Gérer les films</h1>

        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Affiche</th>
                        <th>Titre</th>
                        <th>Genre</th>
                        <th>Durée</th>
                        <th>Date de sortie</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                {% for film in films %}
                    <tr>
                        <td>
                            {% if film.imageFilm %}
                                <img
                                    class="mini"
                                    src="{{ asset('image/' ~ film.imageFilm) }}"
                                    alt="Affiche de {{ film.nomFilm }}"
                                >
                            {% else %}
                                Aucune affiche
                            {% endif %}
                        </td>

                        <td>{{ film.nomFilm }}</td>
                        <td>{{ film.genre ?? 'Non renseigné' }}</td>

                        <td>
                            {% if film.duree %}
                                {{ film.duree }} min
                            {% else %}
                                Non renseignée
                            {% endif %}
                        </td>

                        <td>
                            {% if film.dateSortie %}
                                {{ film.dateSortie|date('d/m/Y') }}
                            {% else %}
                                Non renseignée
                            {% endif %}
                        </td>

                        <td class="actions">
                            <a
                                class="btn btn-jaune"
                                href="{{ path('admin_film_edit', {id: film.idFilm}) }}#formulaire"
                            >
                                Modifier
                            </a>

                            <form
                                method="post"
                                action="{{ path('admin_film_delete', {id: film.idFilm}) }}"
                                onsubmit="return confirm('Supprimer ce film ?');"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('delete' ~ film.idFilm) }}"
                                >

                                <button class="btn btn-rouge" type="submit">
                                    Supprimer
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="vide">
                            Aucun film pour le moment. Ajoute le premier ci-dessous.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

    {# ---------- PARTIE 2 : formulaire ajout / modification ---------- #}
    <section class="bloc" id="formulaire">
        <h2 class="titre">
            {{ isEdit ? 'Modifier le film' : 'Ajouter un film' }}
        </h2>

        {{ form_start(form, {attr: {class: 'formulaire'}}) }}

            {{ form_widget(form) }}

            <div class="formulaire-actions">
                <button class="btn btn-jaune" type="submit">
                    {{ isEdit ? 'Enregistrer les modifications' : 'Ajouter le film' }}
                </button>

                {% if isEdit %}
                    <a
                        class="btn btn-contour"
                        href="{{ path('admin_film_index') }}"
                    >
                        Annuler
                    </a>
                {% endif %}
            </div>

        {{ form_end(form) }}
    </section>

</main>
{% if isEdit %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('formulaire').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        });
    </script>
{% endif %}
{% endblock %}