<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - GrandCiné</title>
    <link rel="icon" type="image/png" href="{{ asset('image/logo.png') }}">
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">
    <script type="module"
        src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js">
    </script>
    <script nomodule
        src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js">
    </script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async defer></script>
</head>
<body>
    <section>
        {{ form_start(registrationForm) }}

            <h1>Inscription</h1>

            {% for message in app.flashes('error') %}
                <div class="erreur">{{ message }}</div>
            {% endfor %}

            {% if registrationForm.vars.errors|length > 0 %}
                <div class="erreur">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {# NOM #}
            <div class="inputbox">
                <ion-icon name="person-outline"></ion-icon>
                {{ form_widget(registrationForm.nom, {
                    attr: {
                        id: 'nom',
                        placeholder: ' ',
                        autocomplete: 'family-name'
                    }
                }) }}
                <label for="{{ registrationForm.nom.vars.id }}">Nom</label>
            </div>
            {% if registrationForm.nom.vars.errors|length > 0 %}
                <div class="erreur">
                    {{ form_errors(registrationForm.nom) }}
                </div>
            {% endif %}

            {# PRENOM #}
            <div class="inputbox">
                <ion-icon name="person-outline"></ion-icon>
                {{ form_widget(registrationForm.prenom, {
                    attr: {
                        id: 'prenom',
                        placeholder: ' ',
                        autocomplete: 'given-name'
                    }
                }) }}
                <label for="{{ registrationForm.prenom.vars.id }}">Prénom</label>
            </div>
            {% if registrationForm.prenom.vars.errors|length > 0 %}
                <div class="erreur">
                    {{ form_errors(registrationForm.prenom) }}
                </div>
            {% endif %}

            {# EMAIL #}
            <div class="inputbox">
                <ion-icon name="mail-outline"></ion-icon>
                {{ form_widget(registrationForm.email, {
                    attr: {
                        id: 'email',
                        placeholder: ' ',
                        autocomplete: 'email'
                    }
                }) }}
                <label for="{{ registrationForm.email.vars.id }}">E-mail</label>
            </div>
            {% if registrationForm.email.vars.errors|length > 0 %}
                <div class="erreur">
                    {{ form_errors(registrationForm.email) }}
                </div>
            {% endif %}

            {# MOT DE PASSE #}
            <div class="inputbox">
                <ion-icon name="lock-closed-outline"></ion-icon>
                {{ form_widget(registrationForm.plainPassword.first, {
                    attr: {
                        id: 'password',
                        placeholder: ' '
                    }
                }) }}
                <label for="{{ registrationForm.plainPassword.first.vars.id }}">
                    Mot de passe
                </label>
            </div>
            {% if registrationForm.plainPassword.first.vars.errors|length > 0 %}
                <div class="erreur">
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>
            {% endif %}

            {# CONFIRMATION #}
            <div class="inputbox">
                <ion-icon name="lock-closed-outline"></ion-icon>
                {{ form_widget(registrationForm.plainPassword.second, {
                    attr: {
                        id: 'passwordBis',
                        placeholder: ' '
                    }
                }) }}
                <label for="{{ registrationForm.plainPassword.second.vars.id }}">
                    Confirmer le mot de passe
                </label>
            </div>
            {% if registrationForm.plainPassword.second.vars.errors|length > 0 %}
                <div class="erreur">
                    {{ form_errors(registrationForm.plainPassword.second) }}
                </div>
            {% endif %}

            {# CAPTCHA Cloudflare #}
            <div class="captcha">
                <div class="cf-turnstile"
                     data-sitekey="0x4AAAAAAFfb7HnTItpdlHeP">
                </div>
            </div>

            <button type="submit">S'inscrire</button>

            <div class="login">
                <p>
                    Tu as déjà un compte ?
                    <a href="{{ path('app_login') }}">Connexion</a>
                </p>
            </div>

        {{ form_end(registrationForm) }}
    </section>
</body>
</html>
