<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CINEMAX - Réservation</title>
    <link rel="stylesheet" href="accueil.css">
    <link rel="stylesheet" href="reservation.css">
    <script src="reservation.js" defer></script>
</head>
<body class="bodyaccueil">

    <header class="headeracueil">
        <div class="header-container">
            <h1 class="logo">CINEMAX</h1>
            <nav>
                <ul class="nav">
                    <li><a href="accueil.html">Accueil</a></li>
                    <li><a href="accueil.html#affiche">A l'affiche</a></li>
                    <li><a href="accueil.html#seances">Séances</a></li>
                    <li><a href="reservation.html">Réservation</a></li>
                    <li><a href="accueil.html#contact">Contact</a></li>
                </ul>
            </nav>
            <form class="search-form">
                <input type="search" name="q" placeholder="Recherche">
            </form>
            <ul class="nav">
                <li><a href="#">Connexion</a></li>
            </ul>
        </div>
    </header>

    <main class="main-reservation">

        <h2 class="titre-section">Gestion des salles</h2>

        <!-- Les 4 cases du haut -->
        <div class="cartes">
            <div class="carte">
                <h3>Capacité totale</h3>
                <p class="chiffre" id="capacite">0</p>
                <p class="petit">Places dans la salle</p>
            </div>
            <div class="carte">
                <h3>Spectateurs</h3>
                <p class="chiffre" id="spectateurs">0</p>
                <p class="petit">Places occupées</p>
            </div>
            <div class="carte">
                <h3>Places disponibles</h3>
                <p class="chiffre" id="disponibles">0</p>
                <p class="petit">Places libres</p>
            </div>
            <div class="carte">
                <h3>Remplissage</h3>
                <p class="chiffre" id="taux">0%</p>
                <div class="barre">
                    <div class="barre-remplie" id="barre"></div>
                </div>
            </div>
        </div>

        <!-- Choix de la salle et plan -->
        <section class="plan">
            <label for="salle">Choisir une salle :</label>
            <select id="salle" class="choix-salle">
                <option value="180">Salle Standard - 180 places</option>
                <option value="300">Salle IMAX - 300 places</option>
                <option value="120">Salle VIP - 120 places</option>
                <option value="70">Salle Événementielle - 70 places</option>
            </select>

            <div class="ecran">ECRAN</div>

            <div class="sieges" id="sieges"></div>

            <div class="legende">
                <span><span class="carre libre"></span> Place libre</span>
                <span><span class="carre occupe"></span> Place occupée</span>
            </div>

            <button class="bouton" id="bouton-simuler">Simuler de nouvelles réservations</button>
        </section>

    </main>

    <footer class="footer" id="contact">
        <p class="footer-logo">CINEMAX</p>
        <p>12 rue du Cinéma - 00000 Ville</p>
        <p>Tél : 01 23 45 67 89 - contact@cinemax.fr</p>
        <p>Ouvert tous les jours de 13h à 23h</p>
    </footer>

</body>
</html>
