
{% include 'partials/header.html.twig' %}

<link rel="stylesheet" href="{{ asset('css/film.css') }}">

<main class="page-films">

    <section class="page-films__top">
        <h1 class="section-title">Tous les films</h1>

        {# Barre de recherche #}
        <form class="film-search" action="{{ path('app_film') }}" method="get" role="search">
            <input type="search"
                   name="q"
                   value="{{ q|default('') }}"
                   placeholder="Rechercher un film..."
                   aria-label="Rechercher un film">

            <button type="submit" class="btn btn--primary">
                Rechercher
            </button>
        </form>
    </section>

    {% if q|default('') %}
        <p class="film-result">
            {{ films|length }} résultat(s) pour « {{ q }} »
        </p>
    {% endif %}

    <div class="films">
        {% for film in films %}
            <article class="film">

                <div class="film__poster">
                    {% if film.imageFilm %}
                        <img src="{{ asset('image/' ~ film.imageFilm) }}"
                             alt="Affiche de {{ film.nomFilm }}">
                    {% else %}
                        <span>{{ film.nomFilm }}</span>
                    {% endif %}
                </div>

                <div class="film__body">
                    <h2 class="film__title">
                        {{ film.nomFilm }}
                    </h2>

                    {% if film.genre %}
                        <p class="film__genre">
                            {{ film.genre }}
                        </p>
                    {% endif %}

                    <p class="film__info">
                        {{ film.description }}
                    </p>

                    <a href="{{ path('app_film_detail', {id: film.idFilm}) }}"
                       class="btn btn--primary btn--block">
                        Voir le détail
                    </a>
                </div>

            </article>
        {% else %}
            <p class="film-empty">
                Aucun film trouvé. Essaie un autre titre.
            </p>
        {% endfor %}
    </div>

</main>

<footer class="footer">
    <p>© {{ 'now'|date('Y') }} GrandCiné</p>
</footer>

</body>
</html>
