{% include 'partials/header.html.twig' %}

<main>

    {# ---------- Bannière ---------- #}
    <section class="banniere">
        <div class="banniere-texte">

            <p class="banniere-genre">Action - Thriller | 2h05</p>

            <h2 class="banniere-titre">NUIT NOIRE</h2>

            <p class="banniere-resume">
                Une ville plongée dans le noir, une seule nuit pour
                retrouver la vérité. À voir sur grand écran dès mercredi.
            </p>

            <a href="#seances" class="bouton">
                Réserver ma place
            </a>

            <a href="#" class="bouton-contour">
                Bande-annonce
            </a>

        </div>
    </section>

    {# ---------- Films récupérés depuis la base de données ---------- #}
    <section class="affiche" id="affiche">

        <h2 class="titre-section">À l'affiche</h2>

        <div class="liste-films">

            {% for film in films|slice(0, 4) %}

                <div class="film">

                    <a href="{{ path('app_film_detail', {id: film.idFilm}) }}">

                        <div class="poster">
                            {% if film.imageFilm %}
                                <img
                                    src="{{ asset('image/' ~ film.imageFilm) }}"
                                    alt="{{ film.nomFilm }}"
                                >
                            {% else %}
                                <span>{{ film.nomFilm }}</span>
                            {% endif %}
                        </div>

                        <h3>{{ film.nomFilm }}</h3>

                        {% if film.genre %}
                            <p class="film__genre">{{ film.genre }}</p>
                        {% endif %}

                        <p>{{ film.description }}</p>

                    </a>

                </div>

            {% else %}

                <p>Aucun film disponible pour le moment.</p>

            {% endfor %}

        </div>

    </section>

    {# ---------- Séances du jour récupérées depuis la base de données ---------- #}
    <section class="seances" id="seances">

        <h2 class="titre-section">Séances du jour</h2>

        {% for seance in seances %}

            <div class="ligne-seance">

                <p class="nom-film">
                    {{ seance.film.nomFilm }}
                </p>

                <div class="horaires">

                    <a href="#">
                        {{ seance.horaireSeance|date('H:i') }}
                    </a>

                </div>

            </div>

        {% else %}

            <p>Aucune séance prévue aujourd'hui.</p>

        {% endfor %}

    </section>

    {# ---------- Tarifs ---------- #}
    <section class="tarifs" id="tarifs">

        <h2 class="titre-section">Tarifs</h2>

        <div class="liste-tarifs">

            <div class="tarif">
                <h3>Plein tarif</h3>
                <p class="prix">10,50 €</p>
            </div>

            <div class="tarif">
                <h3>Tarif réduit</h3>
                <p class="prix">8,00 €</p>
            </div>

            <div class="tarif">
                <h3>Moins de 14 ans</h3>
                <p class="prix">5,50 €</p>
            </div>

        </div>

    </section>

</main>

{# ---------- Footer ---------- #}
<footer class="footer" id="contact">

    <p class="footer-logo">CINEMAX</p>

    <p>12 rue du Cinéma - 00000 Ville</p>

    <p>Tél : 01 23 45 67 89 - contact@cinemax.fr</p>

    <p>Ouvert tous les jours de 13h à 23h</p>

</footer>

</body>
</html>
